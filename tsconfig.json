{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "resolveJsonModule": true,
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "types": ["tampermonkey", "node"]
    },
    "include": ["src/**/*"],
    "exclude": ["src/dev-server.ts"]
}